# AutoApply local environment example.
# Copy to apps/web/.env.local and fill only local/development values.

NEXT_PUBLIC_WEBAPP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-side only. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
PII_ENCRYPTION_KEY=replace-with-64-hex-character-local-key

# Local auth helpers. Keep disabled outside local development.
ENABLE_DEV_LOGIN=false
DEV_LOGIN_EMAIL=dev@example.test
DEV_LOGIN_PASSWORD=replace-with-local-password
DISABLE_AUTH_BYPASS=false
DEV_AUTH_BYPASS_USER_ID=00000000-0000-0000-0000-000000000000
DEV_AUTH_BYPASS_EMAIL=dev@example.test

# Optional provider keys. Leave blank to use deterministic local fallbacks.
GITHUB_TOKEN=
KNOWLEDGE_EMBEDDING_PROVIDER=local
KNOWLEDGE_EXTRACTION_PROVIDER=local
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=512
DASHSCOPE_CHAT_MODEL=qwen-plus
